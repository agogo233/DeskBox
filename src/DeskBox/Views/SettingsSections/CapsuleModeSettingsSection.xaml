<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.CapsuleModeSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeskBox.Controls"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <controls:SettingsBoolToVisibilityConverter x:Key="SettingsBoolToVisibilityConverter" />
            <Style x:Key="CapsuleGroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingTitleTextStyle}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,14,4,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" svc:Localized.Key="Settings.Section.CapsuleMode" />
        <StackPanel Margin="0,8,0,0" Spacing="4">
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Right"
                    svc:Localized.DescriptionKey="Settings.CollapseBehavior.Description"
                    svc:Localized.HeaderKey="Settings.CollapseBehavior.Title">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE73F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        ItemsSource="{Binding AvailableCollapseBehaviorOptions}"
                        controls:SettingsComboBox.Value="{Binding CollapseBehavior, Mode=TwoWay}" />
                </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource CapsuleGroupTitleStyle}" svc:Localized.Key="Settings.Capsule.Group.Common" />

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Capsule.WidthMode.Description"
                svc:Localized.HeaderKey="Settings.Capsule.WidthMode.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.ResetCapsuleWidthOverridesCommand, Mode=OneWay}"
                        IsEnabled="{Binding HasWidthOverrides}"
                        Style="{StaticResource IconActionButtonStyle}"
                        svc:Localized.ToolTipKey="Settings.Capsule.Overrides.ResetWidth">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <ComboBox
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        ItemsSource="{Binding AvailableWidthModeOptions}"
                        controls:SettingsComboBox.Value="{Binding WidthMode, Mode=TwoWay}" />
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Capsule.ExpansionDirection.Description"
                svc:Localized.HeaderKey="Settings.Capsule.ExpansionDirection.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8CB;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableExpansionDirectionOptions}"
                    controls:SettingsComboBox.Value="{Binding ExpansionDirection, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.CompactContent.Description"
                svc:Localized.HeaderKey="Settings.CompactContent.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableContentModeOptions}"
                    controls:SettingsComboBox.Value="{Binding ContentMode, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.Capsule.Arrangement.Description"
                svc:Localized.HeaderKey="Settings.Capsule.Arrangement.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox
                    MinWidth="{StaticResource SettingsControlMinWidth}"
                    ItemsSource="{Binding AvailableArrangementOptions}"
                    controls:SettingsComboBox.Value="{Binding ArrangementMode, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                HorizontalContentAlignment="Right"
                svc:Localized.DescriptionKey="Settings.CompactPrivacy.Description"
                svc:Localized.HeaderKey="Settings.CompactPrivacy.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    IsOn="{Binding HideSensitiveContent, Mode=TwoWay}" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource CapsuleGroupTitleStyle}" svc:Localized.Key="Settings.Capsule.Group.Details" />

            <Border
                Style="{StaticResource SettingsGroupStyle}"
                Visibility="{Binding ShowHoverResponseEntry, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button
                        Grid.Column="0"
                        Click="NestedSettingsButton_Click"
                        IsHitTestVisible="{Binding CanOpenHoverResponseDetails}"
                        IsTabStop="{Binding CanOpenHoverResponseDetails}"
                        Style="{StaticResource DrillDownRowStyle}"
                        Tag="CapsuleBehaviorSettings">
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE823;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Capsule.HoverResponse.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Capsule.HoverResponse.Description" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding AvailableHoverResponseOptions}"
                        controls:SettingsComboBox.Value="{Binding HoverResponse, Mode=TwoWay}" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="12"
                        Glyph="&#xE76C;"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowHoverResponseCustom, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border
                Style="{StaticResource SettingsGroupStyle}"
                Visibility="{Binding ShowArrangementEntry, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button
                        Grid.Column="0"
                        Click="NestedSettingsButton_Click"
                        IsHitTestVisible="{Binding IsBarEnabled}"
                        IsTabStop="{Binding IsBarEnabled}"
                        Style="{StaticResource DrillDownRowStyle}"
                        Tag="CapsuleArrangementSettings">
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE707;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Capsule.ArrangementDetails.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding ArrangementDetailsSummary}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding IsBarEnabled}"
                        ItemsSource="{Binding AvailableBarPlacementOptions}"
                        controls:SettingsComboBox.Value="{Binding BarPlacement, Mode=TwoWay}" />
                    <FontIcon Grid.Column="2" FontSize="12" Glyph="&#xE76C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsGroupStyle}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <Button
                        Grid.Column="0"
                        Click="NestedSettingsButton_Click"
                        IsHitTestVisible="{Binding CanOpenAnimationDetails}"
                        IsTabStop="{Binding CanOpenAnimationDetails}"
                        Style="{StaticResource DrillDownRowStyle}"
                        Tag="CapsuleAnimationSettings">
                        <Grid ColumnDefinitions="Auto,*" Style="{StaticResource SettingCardIdentityGridStyle}">
                            <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE7B5;" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Capsule.Animation.Title" />
                                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" svc:Localized.Key="Settings.Capsule.Animation.Description" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="{StaticResource SettingsControlMinWidth}"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding AvailableAnimationEffectOptions}"
                        controls:SettingsComboBox.Value="{Binding AnimationEffect, Mode=TwoWay}" />
                    <FontIcon
                        Grid.Column="2"
                        FontSize="12"
                        Glyph="&#xE76C;"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowAnimationCustom, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border
                Style="{StaticResource SettingsGroupStyle}"
                Visibility="{Binding ShowOverridesEntry, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                <Button
                    Click="NestedSettingsButton_Click"
                    Style="{StaticResource DrillDownRowStyle}"
                    Tag="CapsuleOverridesSettings">
                    <Grid ColumnDefinitions="Auto,*,Auto" Style="{StaticResource SettingCardIdentityGridStyle}">
                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE713;" IsHitTestVisible="False" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" IsHitTestVisible="False" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingTitleTextStyle}" svc:Localized.Key="Settings.Capsule.Overrides.Title" />
                            <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="{Binding OverrideSummaryText}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontSize="12" Glyph="&#xE76C;" IsHitTestVisible="False" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
